# Spotify API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# LLM provider — lyric/audio-feature description generation
ANTHROPIC_API_KEY=

# Embedding model — vibe similarity search (Voyage AI, OpenAI, or local sentence-transformers — TBD)
EMBEDDING_API_KEY=

# Lyrics source
GENIUS_API_KEY=

# Database
DATABASE_URL=sqlite:///./backend/data/vibe_filter.db
USER_DATA_DIR=./backend/data/users

# Session cookies - generate a real value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse the example/a weak value here - anyone with this secret can
# forge a valid-looking login cookie for any user.
SESSION_SECRET_KEY=
# true in production (HTTPS-only); false for local dev over plain http,
# otherwise the login cookie is silently never sent and login appears to fail.
SESSION_COOKIE_SECURE=false

# Where /callback sends the browser after login finishes. Leave unset
# ("/") in production - frontend and backend share one origin there.
# Locally, set to the frontend dev server's URL (e.g.
# http://127.0.0.1:5173) - Spotify's redirect always lands on THIS
# backend's own port regardless of which port the frontend dev server
# runs on, so a relative "/" would strand you on the backend's static
# files instead of sending you back to the frontend.
FRONTEND_URL=/
