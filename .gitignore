.env
__pycache__/
*.py[cod]
venv/
.venv/
node_modules/
*.db
*.sqlite3
.spotify_token_cache
# Real per-user data (databases + OAuth token caches) - *.db and the
# legacy .spotify_token_cache above already cover most of this, but the
# per-user token cache filename (.token_cache) doesn't match either
# pattern, so excluding the whole directory is the safer, complete fix
# rather than enumerating filenames one at a time.
backend/data/users/
.DS_Store
.vscode/
.idea/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Claude Code's own local session state - not project source, and
# settings.local.json can hold locally-approved permissions that
# shouldn't ship with the repo. Was already covered by this machine's
# global gitignore, but that's not something a clone of this repo can
# rely on - excluded here directly so it's correct for anyone else too.
.claude/

# Frontend build output - regenerated by `npm run build`, not source.
frontend-react/dist/
